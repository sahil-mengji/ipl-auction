# Copy to `.env` and adjust as needed.

# --- Data source -------------------------------------------------------
# Dummy mode: "true" renders local dummy data in the UI, bypassing all
# network calls. Takes precedence over everything below.
VITE_DUMMY_MODE=false

# Backend mode: point the UI at the Express + Prisma + Postgres API in
# ./server (see server/README.md). Requires the backend running, e.g.
# http://localhost:4000
VITE_DATA_SOURCE=backend
VITE_API_URL=http://localhost:4000

# Alternatives:
# - Supabase (legacy default): VITE_DUMMY_MODE=false + VITE_DATA_SOURCE=supabase
# - or simply unset VITE_DATA_SOURCE and VITE_API_URL
